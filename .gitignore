# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data exports
data/*.xlsx
data/*.csv
data/sheets/*.csv

# local QA / Cursor (keep on disk; do not commit)
/.cursor/
/test-images/
/test-results/
/*.zip
.vercel
.superpowers/

# playwright MCP temp output
/.playwright-mcp/

# 리쿠르팅 듀오톤 원본 스톡 (구운 결과 public/recruit-photos만 커밋, 원본은 로컬)
scripts/recruit-photo-src/**/*.jpg
scripts/recruit-photo-src/**/*.jpeg
scripts/recruit-photo-src/**/*.png
scripts/recruit-photo-src/**/*.webp
scripts/recruit-photo-src/**/*.avif

# 임시 탐색/미리보기 (디스크엔 남기되 커밋 안 함) — 마스코트 컨셉·비교 갤러리, 일회성 생성 스크립트
/public/_*
scripts/_*.mjs

# 모델 A/B 생성 리포트(로컬 산출물)
model-ab-report.html

# 삭제 카드 백업
deleted-card-*.json

# 임시 목업 페이지(공개 라우트 — 배포 금지) + Playwright 산출물
app/mock-ab/
.playwright-mcp/

# 영상 작업은 amazing-biz-video repo로 분리 — 배포 repo에 영상 바이너리 금지(실수 방지 안전망)
*.mp4
*.mov
*.webm
*.mkv
/public/recruit-reels/
