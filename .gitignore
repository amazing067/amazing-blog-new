# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data exports
data/*.xlsx
data/*.csv
data/sheets/*.csv

# local QA / Cursor (keep on disk; do not commit)
/.cursor/
/test-images/
/test-results/
/*.zip
.vercel
.superpowers/

# playwright MCP temp output
/.playwright-mcp/

# 리쿠르팅 듀오톤 원본 스톡 (구운 결과 public/recruit-photos만 커밋, 원본은 로컬)
scripts/recruit-photo-src/**/*.jpg
scripts/recruit-photo-src/**/*.jpeg
scripts/recruit-photo-src/**/*.png
scripts/recruit-photo-src/**/*.webp
scripts/recruit-photo-src/**/*.avif

# 임시 탐색/미리보기 (디스크엔 남기되 커밋 안 함) — 마스코트 컨셉·비교 갤러리, 일회성 생성 스크립트
/public/_*
scripts/_*.mjs
